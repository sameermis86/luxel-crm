# --- Database ---------------------------------------------------------------
# Owner role: runs migrations (DDL). On Supabase use the postgres/service connection.
DATABASE_OWNER_URL=postgres://luxel_owner:luxel_owner@localhost:5432/luxel
# App role: what the running app uses. MUST NOT be a superuser or BYPASSRLS so RLS applies.
DATABASE_URL=postgres://luxel_app:luxel_app@localhost:5432/luxel
# Tests (wiped and re-migrated on every run)
TEST_DATABASE_OWNER_URL=postgres://luxel_owner:luxel_owner@localhost:5432/luxel_test
TEST_DATABASE_URL=postgres://luxel_app:luxel_app@localhost:5432/luxel_test

# --- Auth -------------------------------------------------------------------
# "dev" = pick a seeded user at /login (local only, refused when NODE_ENV=production)
# "supabase" = Supabase Auth (magic link / password)
AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000
DEFAULT_ORG_SLUG=luxel

# --- Wix intake ---------------------------------------------------------------
# Shared secret. Wix signs the raw body: X-Luxel-Signature: sha256=<hex hmac>
# (Authorization: Bearer <secret> is also accepted for Wix Automations webhooks.)
WIX_INTAKE_SECRET=change-me-long-random-string
# Backfill via Wix REST API (optional; CSV export works without it)
WIX_API_KEY=
WIX_SITE_ID=

# --- Email --------------------------------------------------------------------
# "console" logs emails to stdout; "resend" sends via Resend
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="Luxel CRM <crm@luxeldecor.com>"

# --- Background jobs ------------------------------------------------------------
# Leave empty locally and run `pnpm inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Setmore API v2 refresh token (from api@setmore.com). Enables the Consultations panel.
SETMORE_REFRESH_TOKEN=
